#!/usr/bin/env node

// Configure environment file
require('dotenv').config();

/**
 * Module dependencies.
 */
var app = require('../app');
var http = require('http');
var cluster = require('cluster');
var os = require('os');

/**
 * Get base port from environment and store in Express.
 */
var basePort = parseInt(process.env.PORT || '3000', 10);
app.set('basePort', basePort);

/**
 * Check if clustering is enabled.
 */
if (process.env.CLUSTER_MODE === 'true' && cluster.isMaster) {
  // Fork workers based on the number of CPU cores
  const numCPUs = os.cpus().length;
  for (let i = 0; i < numCPUs; i++) {
    cluster.fork();
  }

  cluster.on('exit', (worker, code, signal) => {
    console.log(`Worker ${worker.process.pid} died`);
  });

  // Log when the master process is running
  console.log(`Master process is running`);

} else {
  // Determine the port for each worker
  let workerPort;
  
  if (process.env.CLUSTER_PORT_SAME === 'true') {
    // All workers listen on the same port
    workerPort = basePort;
  } else {
    // Each worker gets a unique port
    workerPort = basePort + cluster.worker.id;
  }

  var server = http.createServer(app);

  // Listen on the assigned port, on all network interfaces
  server.listen(workerPort);
  server.on('error', onError);
  server.on('listening', () => onListening(workerPort));
}

/**
 * Event listener for HTTP server "error" event.
 */
function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }
  var bind = 'Port ' + (process.env.CLUSTER_PORT_SAME === 'true' ? basePort : basePort + cluster.worker.id);

  // Handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */
function onListening(workerPort) {
  const workerId = cluster.worker ? `Worker ${cluster.worker.id}` : 'Master';
  console.log(`${workerId} is running on port ${workerPort} with PID ${process.pid}`);
}
